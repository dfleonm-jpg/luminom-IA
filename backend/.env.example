# ===== Servidor =====
# En local el frontend (Vite) hace proxy de /api hacia 127.0.0.1:8000.
# En la nube (Render/Railway) la plataforma define PORT automáticamente.
PORT=8000

# Orígenes permitidos por CORS (separados por coma). Usa * en desarrollo.
# En producción pon la URL de tu frontend, ej:
# CORS_ORIGIN=https://dfleonm-jpg.github.io
CORS_ORIGIN=*

# ===== Base de datos MongoDB =====
# Local:  mongodb://127.0.0.1:27017/astra
# Atlas:  mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/astra?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/astra

# (Solo local/Windows) Arranque automático de mongod si no está corriendo.
# Deja ambos vacíos para desactivarlo (obligatorio en la nube / con Atlas).
MONGOD_PATH=
MONGO_DBPATH=

# ===== IA =====
# Local con Ollama:
OLLAMA_URL=http://127.0.0.1:11434
CHAT_MODEL=qwen2.5:7b
VISION_MODEL=qwen2.5vl:3b
